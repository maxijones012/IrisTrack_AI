<Window x:Class="IrisTrackAI.ZoneEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="#06000000" Topmost="True"
        Cursor="Cross" KeyDown="Window_KeyDown">
    <Grid>
        <Canvas x:Name="EditorCanvas" Background="#01000000"
                MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                MouseMove="Canvas_MouseMove"
                MouseLeftButtonUp="Canvas_MouseLeftButtonUp"/>
        <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,18,0,0"
                Background="#E6081621" BorderBrush="#6632D7FF" BorderThickness="1"
                CornerRadius="10" Padding="14,8" IsHitTestVisible="False">
            <StackPanel>
                <TextBlock x:Name="EditorTitle" Text="DIBUJAR ZONA" Foreground="#32D7FF"
                           FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EditorHelp" Text="Mantené clic izquierdo y arrastrá · ESC cancela"
                           Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
